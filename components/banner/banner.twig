{#
/**
 * @file
 * Banner component
 */
#}

{% set bn_text = text|default("Anuncio importante") %}
{% set bn_link_text = link_text|default("") %}
{% set bn_link_url = link_url|default("") %}
{% set bn_style = style|default("info") %}
{% set bn_dismissible = dismissible|default(true) %}
{% set bn_icon = icon|default(true) %}
{% set bn_position = position|default("inline") %}
{% set custom_class = css_class|default("") %}
{% set custom_id = html_id|default("banner-" ~ random()) %}

{% set style_classes = {
  info: "bg-blue-50 text-blue-900 border-blue-200",
  success: "bg-green-50 text-green-900 border-green-200",
  warning: "bg-amber-50 text-amber-900 border-amber-200",
  error: "bg-red-50 text-red-900 border-red-200",
  primary: "bg-primary text-white",
  gradient: "bg-gradient-to-r from-primary to-accent text-white"
} %}

{% set position_classes = {
  top: "fixed top-0 left-0 right-0 z-50",
  inline: ""
} %}

{% set classes = [
  "cats-banner px-4 py-3 border-b",
  style_classes[bn_style],
  position_classes[bn_position],
  custom_class
]|join(" ")|trim %}

<div {{ attributes }}
  class="{{ classes }}"
  id="{{ custom_id }}"
  role="alert"
>
  <div class="flex items-center justify-center gap-3">
    {% if bn_icon %}
      <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
      </svg>
    {% endif %}
    <span class="text-sm font-medium">{{ bn_text }}</span>
    {% if bn_link_text and bn_link_url %}
      <a href="{{ bn_link_url }}" class="text-sm font-semibold underline hover:no-underline">{{ bn_link_text }}</a>
    {% endif %}
    {% if bn_dismissible %}
      <button type="button" class="ml-auto p-1 hover:opacity-70 transition-opacity" onclick="this.closest('[role=alert]').remove()">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    {% endif %}
  </div>
</div>
