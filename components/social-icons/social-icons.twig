{#
/**
 * @file
 * Social Icons component - Iconos de redes sociales
 */
#}

{% set social_style = style|default('default') %}
{% set social_size = size|default('md') %}
{% set social_alignment = alignment|default('center') %}
{% set social_gap = gap|default('md') %}
{% set custom_class = css_class|default('') %}
{% set custom_id = html_id|default('') %}

{% set wrapper =
  html_cva(
    base: ['cats-social-icons flex flex-wrap'],
    variants: {
      alignment: {
        left: 'justify-start',
        center: 'justify-center',
        right: 'justify-end'
      },
      gap: {
        none: 'gap-0',
        sm: 'gap-2',
        md: 'gap-4',
        lg: 'gap-6',
        xl: 'gap-8'
      }
    }
  )
%}

{% set wrapper_classes =
  wrapper.apply({
    alignment: social_alignment,
    gap: social_gap
  }, custom_class)|trim
%}

<div {{ attributes }} 
  class="{{ wrapper_classes }}" 
  data-style="{{ social_style }}" 
  data-size="{{ social_size }}"
  {% if custom_id %}id="{{ custom_id }}"{% endif %}
>
  {% block icons %}
  {% endblock %}
</div>
