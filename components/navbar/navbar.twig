{#
/**
 * @file
 * Cats Navbar component - Simple navigation bar with logo, menu, and CTAs.
 */
#}
{% set navbar_classes = [
  'cats-navbar',
  'relative z-50 w-full',
  sticky ? 'sticky top-0' : '',
  transparent ? 'bg-transparent' : 'bg-background border-b border-border',
] %}

{% set nav_align_classes = {
  'left': 'justify-start',
  'center': 'justify-center', 
  'right': 'justify-end'
} %}

<nav {{ attributes }} class="{{ navbar_classes|join(' ')|trim }}">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16 md:h-20">
      
      {# Logo #}
      <div class="cats-navbar__logo flex-shrink-0">
        {% block logo %}
          <a href="/" class="flex items-center">
            <span class="text-xl font-bold text-foreground">{{ 'Site Logo'|t }}</span>
          </a>
        {% endblock %}
      </div>

      {# Navigation - Desktop #}
      <div class="cats-navbar__nav hidden md:flex flex-1 px-8 {{ nav_align_classes[menu_align|default('center')] }}">
        {% block navigation %}
          <div class="flex items-center gap-6">
            <a href="#" class="text-foreground/80 hover:text-foreground transition-colors">{{ 'Home'|t }}</a>
            <a href="#" class="text-foreground/80 hover:text-foreground transition-colors">{{ 'Features'|t }}</a>
            <a href="#" class="text-foreground/80 hover:text-foreground transition-colors">{{ 'Pricing'|t }}</a>
            <a href="#" class="text-foreground/80 hover:text-foreground transition-colors">{{ 'Contact'|t }}</a>
          </div>
        {% endblock %}
      </div>

      {# CTA Links #}
      <div class="cats-navbar__links hidden md:flex items-center gap-3">
        {% block links %}
        {% endblock %}
      </div>

      {# Mobile menu button #}
      <button 
        class="cats-navbar__toggle md:hidden p-2 text-foreground"
        aria-label="{{ 'Toggle menu'|t }}"
        data-navbar-toggle
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

    </div>
  </div>

  {# Mobile menu #}
  <div class="cats-navbar__mobile hidden md:hidden bg-background border-t border-border" data-navbar-menu>
    <div class="container mx-auto px-4 py-4">
      {{ block('navigation') }}
      <div class="mt-4 flex flex-col gap-2">
        {{ block('links') }}
      </div>
    </div>
  </div>
</nav>
