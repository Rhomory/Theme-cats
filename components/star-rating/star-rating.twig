{#
/**
 * @file
 * Star Rating component
 */
#}

{% set star_rating = rating|default(4) %}
{% set star_max = max_rating|default(5) %}
{% set star_size = size|default("md") %}
{% set star_color = color|default("yellow") %}
{% set star_show_value = show_value|default(false) %}
{% set custom_class = css_class|default("") %}
{% set custom_id = html_id|default("") %}

{% set size_classes = {
  sm: "w-4 h-4",
  md: "w-5 h-5",
  lg: "w-6 h-6"
} %}

{% set color_classes = {
  yellow: "text-amber-400",
  primary: "text-primary",
  accent: "text-accent"
} %}

{% set classes = [
  "cats-star-rating inline-flex items-center gap-0.5",
  custom_class
]|join(" ")|trim %}

<div {{ attributes }}
  class="{{ classes }}"
  {% if custom_id %}id="{{ custom_id }}"{% endif %}
  role="img"
  aria-label="{{ star_rating }} de {{ star_max }} estrellas"
>
  {% for i in 1..star_max %}
    {% set fill_percent = ((star_rating - (i - 1)) * 100)|clamp(0, 100) %}
    <svg class="{{ size_classes[star_size] }} {{ fill_percent > 0 ? color_classes[star_color] : 'text-gray-300' }}" fill="currentColor" viewBox="0 0 20 20">
      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
    </svg>
  {% endfor %}
  {% if star_show_value %}
    <span class="ml-2 text-sm text-muted">{{ star_rating }}/{{ star_max }}</span>
  {% endif %}
</div>
