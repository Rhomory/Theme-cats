{#
/**
 * @file
 * Cats theme - Compatible with Canvas Experience Builder.
 *
 * IMPORTANT: Header and Footer regions MUST be rendered without conditionals
 * for Canvas to detect and allow editing them.
 */
#}
<div class="layout-container flex min-h-screen flex-col">

  {# --- HEADER - NO conditionals for Canvas compatibility --- #}
  <header role="banner" class="cats-header w-full">
    {{ page.header }}
  </header>

  {# --- MAIN CONTENT --- #}
  <main role="main" class="cats-main flex-grow">
    <a id="main-content" tabindex="-1"></a>

    {{ page.hero }}
    {{ page.highlighted }}
    {{ page.help }}
    {{ page.breadcrumb }}

    <div class="layout-content">
      {{ page.content }}
    </div>

    {% if page.sidebar_first %}
      <aside class="layout-sidebar-first" role="complementary">
        {{ page.sidebar_first }}
      </aside>
    {% endif %}

    {% if page.sidebar_second %}
      <aside class="layout-sidebar-second" role="complementary">
        {{ page.sidebar_second }}
      </aside>
    {% endif %}
  </main>

  {# --- FOOTER - NO conditionals for Canvas compatibility --- #}
  <footer role="contentinfo" class="cats-footer w-full">
    {{ page.footer }}
  </footer>

</div>
